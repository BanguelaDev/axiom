# Variáveis públicas: entram no app. Nunca inserir service_role ou chaves dos fornecedores.
# Para Supabase, usar um projeto de testes separado da produção.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# API descartável, somente em desenvolvimento. No navegador, o padrão é 127.0.0.1:8787.
# No celular, deixe vazio até configurar Supabase local com acesso na rede.
EXPO_PUBLIC_LOCAL_API_URL=
