# Somente no servidor. Crie uma chave em projeto Google AI Studio Free Tier SEM faturamento.
GEMINI_API_KEY=
# Vazio/true: habilita a geração gratuita quando a chave estiver configurada. false: somente apresentação técnica.
AXIOM_LOCAL_GENERATION=true
# Desenvolvimento no computador. Para celular, use npm run dev:lan.
AXIOM_DEV_HOST=127.0.0.1

# Infraestrutura remota opcional. Não é necessária para apresentar localmente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
AXIOM_ENVIRONMENT=staging
AXIOM_GENERATION_ENABLED=false
ALLOWED_ORIGINS=http://localhost:8081
