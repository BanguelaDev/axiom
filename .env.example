# Somente no servidor / prova de viabilidade. Nunca usar prefixo EXPO_PUBLIC_ nestas chaves.
GNEWS_API_KEY=
# Arquivo privado com domínios e grupos editoriais revisados. Consulte docs/news-selection.md.
NEWS_PUBLISHERS_FILE=./work/news-publishers.json
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Preencher true somente depois de confirmar os direitos de processamento, resumo e narração.
CONTENT_RIGHTS_CONFIRMED=false
# Para as próximas etapas de integração:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Secrets da Edge Function (não usar no app): staging ou production.
AXIOM_ENVIRONMENT=staging
ALLOWED_ORIGINS=http://localhost:8081
